---
/**
 * Agencies and partners (content.md §10; design-system §9.7, §9.8).
 * 15 uniform tiles, filter chips with a FLIP layout animation. Without script all 15 tiles show and the
 * chips (which need script) stay hidden.
 */
import { Image } from 'astro:assets';
import SectionHeading from './SectionHeading.astro';
import { agencies, agenciesHeading, agencyCategories } from '../data/agencies';

const total = agencies.length;
---

<section class="section section--alt agencies" id="agencies" aria-labelledby="agencies-title">
  <div class="container">
    <SectionHeading
      title={agenciesHeading}
      id="agencies-title"
    />

    <div class="agencies__filter" data-filter-bar>
      <div class="chips" role="group" aria-label="Filter by category">
        {
          agencyCategories.map((cat, i) => (
            <button type="button" class="chip press" data-category={cat} aria-pressed={i === 0 ? 'true' : 'false'}>
              <span class="chip__check icon" style="--icon: var(--icon-check)" aria-hidden="true" />
              <span>{cat}</span>
            </button>
          ))
        }
      </div>
      <p class="agencies__count" role="status" aria-live="polite" data-result>Showing all {total} agencies and partners</p>
    </div>

    <ul class="grid" data-grid data-reveal-stagger>
      {
        agencies.map((a) => (
          <li class="tile-item" data-category={a.category}>
            <a class="tile" href={a.href} target="_blank" rel="noopener noreferrer">
              <span class="tile__logo">
                <Image src={a.logo} alt="" width={112} quality={80} loading="lazy" decoding="async" />
              </span>
              <span class="tile__ext icon" style="--icon: var(--icon-external-link)" aria-hidden="true" />
              <span class="tile__body">
                {a.acronym && !a.nameUnverified && <span class="eyebrow tile__acronym">{a.acronym}</span>}
                <span class="tile__name" lang={a.name === 'Dangal ng Lipi' ? 'fil' : undefined}>{a.name}</span>
                {a.description && !a.nameUnverified && <span class="tile__desc">{a.description}</span>}
              </span>
              <span class="visually-hidden"> (opens in a new tab)</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .agencies__filter {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3) var(--space-5);
    margin-block-end: var(--space-5);
  }
  /* Chips need script; without it the grid simply shows everything. */
  .agencies__filter { display: none; }
  :global(.js) .agencies__filter { display: flex; }

  .chips { display: flex; flex-wrap: wrap; gap: var(--space-2); }
  .chip {
    display: inline-flex;
    align-items: center;
    min-block-size: 36px;
    padding: 0 var(--space-4);
    border: 1.5px solid var(--border-strong);
    border-radius: var(--radius-full);
    background: var(--white);
    color: var(--navy-950);
    font-size: var(--text-sm);
    font-weight: 600;
    cursor: pointer;
    transition:
      transform var(--dur-instant) var(--ease-spring),
      background-color var(--dur-fast) var(--ease-out),
      border-color var(--dur-fast) var(--ease-out),
      color var(--dur-fast) var(--ease-out);
  }
  .chip:hover { background: var(--navy-50); }
  .chip:active { transform: scale(var(--press-scale)); }
  .chip[aria-pressed='true'] { background: var(--navy-950); border-color: var(--navy-950); color: var(--white); }
  .chip[aria-pressed='true']:hover { background: var(--navy-900); }
  .chip:disabled { opacity: 0.4; cursor: not-allowed; }

  /* The check "draws in": its slot opens with transform only, so the chip never changes width. */
  .chip__check {
    inline-size: 0;
    block-size: 16px;
    overflow: hidden;
    --icon-style-size: 16px;
    --icon-style-voffset: 0;
    opacity: 0;
    transform: scale(0.4);
    transition: transform var(--dur-fast) var(--ease-spring), opacity var(--dur-fast) var(--ease-out);
  }
  .chip__check::before { margin-inline-end: 0; }
  .chip[aria-pressed='true'] .chip__check { opacity: 1; transform: none; inline-size: 16px; margin-inline-end: var(--space-1); }
  @media (prefers-reduced-motion: reduce) { .chip__check { transform: none; } }

  .agencies__count { font-size: var(--text-sm); color: var(--fg-muted); font-variant-numeric: tabular-nums; }

  /* Grid ------------------------------------------------------------------------------------------- */
  .grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-3); }
  @media (min-width: 641px) { .grid { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-4); } }
  @media (min-width: 1025px) { .grid { grid-template-columns: repeat(5, minmax(0, 1fr)); } }
  .tile-item[hidden] { display: none; }

  .tile {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    block-size: 100%;
    padding: var(--space-4);
    border-radius: var(--radius-lg);
    background: var(--white);
    box-shadow: var(--shadow-1);
    color: var(--fg);
    text-decoration: none;
    transition:
      transform var(--dur-instant) var(--ease-spring),
      box-shadow var(--dur-fast) var(--ease-out),
      background-color var(--dur-fast) var(--ease-out);
  }
  @media (min-width: 641px) { .tile { padding: var(--space-5) var(--space-4) var(--space-4); } }
  .tile:hover { text-decoration: none; background: var(--navy-50); }
  @media (hover: hover) { .tile:hover { transform: var(--hover-lift); box-shadow: var(--shadow-2); } }
  .tile:active { transform: scale(var(--press-scale)); }

  .tile__logo {
    display: grid;
    place-items: center;
    inline-size: 56px;
    block-size: 56px;
    padding: var(--space-1);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: var(--white);
  }
  .tile__logo img { inline-size: 100%; block-size: 100%; object-fit: contain; }

  .tile__ext {
    position: absolute;
    inset-block-start: var(--space-3);
    inset-inline-end: var(--space-3);
    color: var(--text-muted);
    --icon-style-size: 20px;
    --icon-style-voffset: 0;
    transition: transform var(--dur-fast) var(--ease-out), color var(--dur-fast) var(--ease-out);
  }
  .tile:hover .tile__ext { transform: translate(2px, -2px); color: var(--navy-700); }

  .tile__body { display: flex; flex-direction: column; gap: var(--space-1); }
  .tile__acronym { color: var(--gold-700); line-height: 1.3; }
  .tile__name { font-size: var(--text-base); font-weight: 600; line-height: 1.35; color: var(--navy-950); overflow-wrap: anywhere; }
  .tile:hover .tile__name { text-decoration: underline; text-underline-offset: 3px; }
  .tile__desc { font-size: var(--text-sm); color: var(--fg-muted); line-height: 1.45; }
</style>

<script>
  const section = document.querySelector<HTMLElement>('#agencies');
  if (section) {
    const root = document.documentElement;
    const css = (name: string) => getComputedStyle(root).getPropertyValue(name).trim();
    const ms = (name: string) => parseFloat(css(name)) || 0;
    const reduced = () => matchMedia('(prefers-reduced-motion: reduce)').matches;

    const chips = [...section.querySelectorAll<HTMLButtonElement>('.chip')];
    const grid = section.querySelector<HTMLElement>('[data-grid]')!;
    const items = [...grid.querySelectorAll<HTMLElement>('.tile-item')];
    const count = section.querySelector<HTMLElement>('[data-result]')!;
    let token = 0;

    const message = (cat: string, n: number) => {
      if (cat === 'All') return `Showing all ${n} agencies and partners`;
      return `Showing ${n} of ${items.length}: ${cat}`;
    };

    const select = async (cat: string) => {
      const run = ++token;
      const match = (el: HTMLElement) => cat === 'All' || el.dataset.category === cat;
      const before = new Map(items.filter((el) => !el.hidden).map((el) => [el, el.getBoundingClientRect()]));
      const leaving = items.filter((el) => !el.hidden && !match(el));
      const entering = items.filter((el) => el.hidden && match(el));
      const n = items.filter(match).length;

      chips.forEach((c) => c.setAttribute('aria-pressed', String(c.dataset.category === cat)));
      count.textContent = message(cat, n);

      // Stop any animation from a previous, faster click so measurements start from the real layout.
      items.forEach((el) => el.getAnimations().forEach((a) => a.cancel()));

      const apply = () => {
        items.forEach((el) => { el.hidden = !match(el); });
      };

      if (reduced()) { apply(); return; }

      // 1) Exit: tiles that no longer match fade out quickly (exits are faster than enters).
      if (leaving.length) {
        const out = leaving.map((el) =>
          el.animate(
            [{ opacity: 1, transform: 'none' }, { opacity: 0, transform: 'scale(0.96)' }],
            { duration: ms('--dur-instant'), easing: css('--ease-in'), fill: 'forwards' },
          ).finished,
        );
        await Promise.allSettled(out);
        if (run !== token) return;
      }

      // 2) FLIP: apply the new layout, then play each tile from its old position to its new one.
      apply();
      const medium = ms('--dur-medium');
      const easeOut = css('--ease-out');
      items.forEach((el, i) => {
        if (el.hidden) return;
        el.getAnimations().forEach((a) => a.cancel());
        if (entering.includes(el)) {
          el.animate(
            [{ opacity: 0, transform: 'scale(0.96)' }, { opacity: 1, transform: 'none' }],
            { duration: medium, easing: easeOut, delay: Math.min(i, 8) * ms('--stagger'), fill: 'backwards' },
          );
          return;
        }
        const first = before.get(el);
        if (!first) return;
        const last = el.getBoundingClientRect();
        const dx = first.left - last.left;
        const dy = first.top - last.top;
        if (!dx && !dy) return;
        el.animate(
          [{ transform: `translate(${dx}px, ${dy}px)` }, { transform: 'none' }],
          { duration: medium, easing: css('--ease-in-out') },
        );
      });
    };

    chips.forEach((chip) => chip.addEventListener('click', () => select(chip.dataset.category ?? 'All')));
  }
</script>
