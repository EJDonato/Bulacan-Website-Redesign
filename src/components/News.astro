---
/** News and announcements: three equal cards across the full width. */
import '../styles/buttons.css';
import '../styles/news.css';
import SectionHeading from './SectionHeading.astro';
import NewsCard from './NewsCard.astro';
import { news, newsHeading } from '../data/news';

// "View all news" has no destination yet (content.md §13), so no link is rendered.
const viewAll = newsHeading.viewAllHref
  ? { label: newsHeading.viewAll, href: newsHeading.viewAllHref, external: newsHeading.viewAllHref.startsWith('http') }
  : undefined;
---

<section class="section" id="news" aria-labelledby="news-heading">
  <div class="container">
    <SectionHeading id="news-heading" title={newsHeading.title} lead={newsHeading.lead} link={viewAll} />

    <ul class="news-grid" data-reveal-stagger>
      {news.map((item) => <li><NewsCard item={item} /></li>)}
    </ul>
  </div>
</section>
