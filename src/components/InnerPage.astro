---
import '../styles/buttons.css';
import '../styles/inner.css';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from './Header.astro';
import type { PageEntry } from '../data/pages';

/**
 * Placeholder template for concept pages that have no dedicated component yet (see components/dedicated.ts).
 * Honest by design: it says the page is not designed yet and points to the original.
 */
interface Props {
  page: PageEntry;
}

const { page } = Astro.props;
const home = import.meta.env.BASE_URL;
const hasChildren = page.groups.some((g) => g.items.length);
const count = page.groups.reduce((n, g) => n + g.items.length, 0);
const hasExternal = page.groups.some((g) => g.items.some((c) => c.external));
---

<BaseLayout title={page.title} description={`${page.title}. A placeholder page in a concept redesign of the Provincial Government of Bulacan website. Not the official website.`}>
  <Header slot="header" />

  <div class="inner">
    <nav class="breadcrumb" aria-label="Breadcrumbs">
      <ol class="container">
        <li><a href={home}>Home</a></li>
        {
          page.crumbs.map((c) => (
            <li>{c.href ? <a href={c.href}>{c.title}</a> : <span class="breadcrumb-text">{c.title}</span>}</li>
          ))
        }
        <li><a href={page.href} aria-current="page">{page.title}</a></li>
      </ol>
    </nav>

    <header class="inner-intro">
      <div class="container inner-intro-grid">
        <div class="inner-intro-text">
          <h1>{page.title}</h1>
          {hasChildren && <p class="inner-lead">{count} {count === 1 ? 'page' : 'pages'} in this section.</p>}
        </div>
      </div>
    </header>

    <section class="container inner-body" aria-labelledby="notice-title">
      <div class="inner-notice">
        <h2 id="notice-title">This page is not designed yet</h2>
        <p>
          This concept redesigns the homepage and a few key pages. This page is a placeholder for one of them.
          The full content is on the official website of the Provincial Government of Bulacan.
        </p>
        <div class="inner-actions">
          <a class="btn btn--primary" href={page.official} target="_blank" rel="noopener noreferrer">
            View the original page on bulacan.gov.ph<span class="visually-hidden"> (opens in a new tab)</span>
          </a>
          <a class="btn btn--secondary" href={home}>Back to the homepage</a>
        </div>
      </div>

      {hasExternal && <p class="inner-legend">Links with an arrow open the official site in a new tab.</p>}

      {
        page.groups.map((group, gi) => (
          <section class="inner-group" aria-labelledby={`group-${gi}`}>
            <h2 id={`group-${gi}`}>{group.label ?? (page.groups.length > 1 ? 'Pages' : 'In this section')}</h2>
            <ul class="inner-cards">
              {group.items.map((c) => (
                <li>
                  {c.href ? (
                    <a
                      class:list={['inner-card', { 'icon-end': c.external }]}
                      href={c.href}
                      style={c.external ? '--icon-end: var(--icon-external-link)' : undefined}
                      target={c.external ? '_blank' : undefined}
                      rel={c.external ? 'noopener noreferrer' : undefined}
                    >
                      {c.title}
                    </a>
                  ) : (
                    <span class="inner-card is-unavailable" title="Link unavailable on the official site">
                      {c.title}
                      <span class="visually-hidden"> (link unavailable on the official site)</span>
                    </span>
                  )}
                </li>
              ))}
            </ul>
          </section>
        ))
      }
    </section>
  </div>
</BaseLayout>
