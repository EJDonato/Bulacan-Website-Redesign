---
import PageShell from '../PageShell.astro';
import { offices, municipalEmergency, otherEmergency } from '../../data/directory';
import type { PageEntry } from '../../data/pages';

/** Offices: the provincial government's offices (they live on the official site) and emergency numbers. */
interface Props {
  page: PageEntry;
}
const { page } = Astro.props;

// "Office of the Governor (GO)" -> name + acronym tag
const rows = offices.map((o) => {
  const m = o.name.match(/^(.*?)\s*\(([^()]+)\)\s*$/);
  return { href: o.href, name: m ? m[1] : o.name, abbr: m ? m[2] : '' };
});

// "796-2087 / 662-0273" -> one tap-to-call link per local number (area code 044); anything else stays plain text
const callable = (value: string) =>
  value.split('/').map((part) => {
    const n = part.trim();
    return /^\d{3}-\d{4}$/.test(n) ? { n, href: `tel:+6344${n.replace('-', '')}` } : { n, href: '' };
  });
---

<PageShell
  page={page}
  lead={`${offices.length} provincial offices, and emergency numbers for the province and every city and municipality.`}
  description="Provincial government offices and emergency numbers of Bulacan. A page in a concept redesign, not the official website."
>
  <nav class="pill-tabs" aria-label="On this page">
    <a href="#offices">Offices</a>
    <a href="#emergency">Emergency numbers</a>
  </nav>

  <section class="page-section" id="offices" aria-labelledby="offices-h" data-filter="offices">
    <div class="section-bar">
      <div>
        <h2 id="offices-h">Provincial government offices</h2>
        <p class="page-note">Each office has its own page on bulacan.gov.ph; links open there in a new tab.</p>
      </div>
      <div class="find" data-filter-box hidden>
        <label for="office-find">Find an office</label>
        <input id="office-find" type="search" placeholder="For example: health, budget, tourism" autocomplete="off" data-filter-input />
        <p class="find-status" role="status" data-filter-status></p>
      </div>
    </div>

    <ul class="office-list" role="list">
      {
        rows.map((o) => (
          <li data-filter-item>
            <a class="office icon-end" style="--icon-end: var(--icon-external-link)" href={o.href} target="_blank" rel="noopener noreferrer">
              <span class="office__abbr">{o.abbr}</span>
              <span class="office__name">{o.name}<span class="visually-hidden"> (opens in a new tab)</span></span>
            </a>
          </li>
        ))
      }
    </ul>
    <p class="page-note" data-filter-empty hidden>No office matches that search.</p>
  </section>

  <section class="page-section" id="emergency" aria-labelledby="emergency-h" data-filter="places">
    <h2 id="emergency-h">Emergency numbers</h2>
    <h3 class="emergency-sub">Provincial emergency numbers</h3>
    <dl class="hotlines">
      {
        otherEmergency.map((e) => (
          <div>
            <dt>{e.label}</dt>
            <dd>
              {callable(e.number).map((c, i) => (
                <>
                  {i > 0 && <span class="hotlines__or"> / </span>}
                  {c.href ? <a href={c.href}>{c.n}</a> : c.n}
                </>
              ))}
            </dd>
          </div>
        ))
      }
    </dl>

    <div class="section-bar">
      <div>
        <h3 class="emergency-sub">Emergency numbers by city and municipality</h3>
        <p class="page-note">
          Fire (BFP), police (PNP) and the city or municipal disaster council (CDCC/MDCC), as listed by the Province.
          Numbers are copied as published; area code 044 unless shown.
        </p>
      </div>
      <div class="find" data-filter-box hidden>
        <label for="place-find">Find a city or municipality</label>
        <input id="place-find" type="search" placeholder="For example: Malolos" autocomplete="off" data-filter-input />
        <p class="find-status" role="status" data-filter-status></p>
      </div>
    </div>

    <div class="table-wrap" tabindex="0" role="region" aria-label="Emergency numbers by city and municipality">
      <table class="data-table">
        <thead>
          <tr>
            <th scope="col">City or municipality</th>
            <th scope="col">Fire (BFP)</th>
            <th scope="col">Police (PNP)</th>
            <th scope="col">Disaster council</th>
          </tr>
        </thead>
        <tbody>
          {
            municipalEmergency.map((m) => (
              <tr data-filter-item>
                <th scope="row">{m.place}</th>
                {[m.fire, m.police, m.disaster].map((v) => (
                  <td>
                    {v ? callable(v).map((c, i) => (
                      <>
                        {i > 0 && ' / '}
                        {c.href ? <a href={c.href}>{c.n}</a> : c.n}
                      </>
                    )) : '—'}
                  </td>
                ))}
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>

  </section>
</PageShell>

<script>
  import '../../scripts/listFilter';
</script>
