---
import geo from '../../data/bulacan-municipalities.json';

/**
 * Tilted, extruded map of Bulacan drawn at build time from municipal boundaries (faeldon/philippines-json-maps, PSGC).
 * Each town is a link to its page and highlights in step with its card in the list beside it.
 */
interface Town {
  name: string;
  href: string;
  city: boolean;
}
interface Props {
  towns: Town[];
}
const { towns } = Astro.props;

// Boundary-file names -> the names this site uses.
const alias: Record<string, string> = {
  'City of Baliwag': 'Baliwag City',
  'Bulacan': 'Bulakan',
  'City of Meycauayan': 'Meycauayan City',
  'City of San Jose Del Monte': 'San Jose del Monte City',
};

const LAT = 14.85;
const K = 1000;
const DEPTH = 16; // extrusion height, in map units
// Equirectangular, then a gentle tilt: squash vertically, shear sideways, so the shape reads as a slab seen from above.
const project = ([lon, lat]: number[]) => {
  const x = (lon - 120.6) * Math.cos((LAT * Math.PI) / 180) * K;
  const y = -(lat - 14.5) * K;
  return [x * 0.94 - y * 0.12, y * 0.92];
};

const rings = (g: any): number[][][] => (g.type === 'Polygon' ? g.coordinates : g.coordinates.flat());
const shapes = geo.features.map((f: any) => {
  const name = alias[f.properties.name] ?? f.properties.name;
  const town = towns.find((t) => t.name.toLowerCase() === name.toLowerCase());
  const pts = rings(f.geometry).map((r) => r.map(project));
  const d = pts.map((r) => 'M' + r.map(([x, y]) => `${x.toFixed(1)} ${y.toFixed(1)}`).join('L') + 'Z').join('');
  return { name: town?.name ?? name, d, town, pts };
});
const all = shapes.flatMap((s) => s.pts.flat());
const minX = Math.min(...all.map((p) => p[0])) - 8;
const maxX = Math.max(...all.map((p) => p[0])) + 8;
const minY = Math.min(...all.map((p) => p[1])) - 8;
const maxY = Math.max(...all.map((p) => p[1])) + DEPTH + 8;
const view = `${minX.toFixed(0)} ${minY.toFixed(0)} ${(maxX - minX).toFixed(0)} ${(maxY - minY).toFixed(0)}`;
---

<figure class="bmap" data-bmap>
  <svg viewBox={view} role="group" aria-label="Map of Bulacan. Each city or municipality is a link to its page.">
    <g class="bmap__depth" aria-hidden="true" transform={`translate(0 ${DEPTH})`}>
      {shapes.map((s) => <path d={s.d} />)}
    </g>
    <g class="bmap__land">
      {
        shapes.map((s) =>
          s.town ? (
            <a href={s.town.href} target="_blank" rel="noopener noreferrer" data-town={s.town.name} data-kind={s.town.city ? 'City' : 'Municipality'}>
              <title>{s.name}</title>
              <path d={s.d} class={s.town.city ? 'is-city' : ''} />
            </a>
          ) : (
            <path d={s.d} />
          ),
        )
      }
    </g>
  </svg>
  <figcaption class="bmap__caption" aria-live="polite" data-bmap-caption>Hover or tap a town to see its name.</figcaption>
  <p class="bmap__legend"><span class="bmap__key bmap__key--city"></span>City <span class="bmap__key"></span>Municipality</p>
</figure>

<script>
  document.querySelectorAll<HTMLElement>('[data-bmap]').forEach((map) => {
    const caption = map.querySelector<HTMLElement>('[data-bmap-caption]')!;
    const idle = caption.textContent;
    const links = [...map.querySelectorAll<SVGAElement>('a[data-town]')];
    const cards = [...document.querySelectorAll<HTMLElement>('[data-town-card]')];
    const show = (name: string | null) => {
      const link = links.find((l) => l.dataset.town === name);
      caption.textContent = link ? `${name} · ${link.dataset.kind}` : idle;
      links.forEach((l) => l.classList.toggle('is-active', l === link));
      cards.forEach((c) => c.classList.toggle('is-active', c.dataset.townCard === name));
    };
    links.forEach((l) => {
      for (const ev of ['pointerenter', 'focus']) l.addEventListener(ev, () => show(l.dataset.town!));
      for (const ev of ['pointerleave', 'blur']) l.addEventListener(ev, () => show(null));
    });
    cards.forEach((c) => {
      for (const ev of ['pointerenter', 'focusin']) c.addEventListener(ev, () => show(c.dataset.townCard!));
      for (const ev of ['pointerleave', 'focusout']) c.addEventListener(ev, () => show(null));
    });
  });
</script>
