---
import PageShell from '../PageShell.astro';
import { eeoPolicy, hrGroups, pdsForms, vacancies } from '../../data/hr';
import type { PageEntry } from '../../data/pages';

/** HR Corner: open positions first (what most visitors come for), then policies, forms and the EEO statement. */
interface Props {
  page: PageEntry;
}
const { page } = Astro.props;
const open = vacancies.length;
---

<PageShell
  page={page}
  eyebrow="Provincial Human Resource Management Office"
  lead={`${open} published vacant plantilla positions, the Province's HR policies, and the forms you need to apply.`}
  description="Vacant positions, HR policies and application forms of the Provincial Government of Bulacan. A page in a concept redesign, not the official website."
>
  <nav class="pill-tabs" aria-label="On this page">
    <a href="#vacancies">Vacant positions</a>
    <a href="#forms">Forms</a>
    <a href="#policies">Policies</a>
    <a href="#eeo">Equal opportunity</a>
  </nav>

  <section class="page-section" id="vacancies" aria-labelledby="vacancies-h" data-filter="positions">
    <h2 id="vacancies-h">Publication of vacant plantilla positions</h2>
    <p class="page-note">Newest first. Each notice opens as a file on bulacan.gov.ph.</p>

    <div class="find" data-filter-box hidden>
      <label for="vacancy-find">Find a position or office</label>
      <input id="vacancy-find" type="search" placeholder="For example: nurse, accounting, 2026" autocomplete="off" data-filter-input />
      <p class="find-status" role="status" data-filter-status></p>
    </div>

    <ul class="doc-list vacancy-list" role="list">
      {
        vacancies.map((v) => (
          <li data-filter-item>
            {v.href ? (
              <a class="doc" href={v.href} target="_blank" rel="noopener noreferrer">
                <span class="doc__icon icon-start" style="--icon-start: var(--icon-file-text)" aria-hidden="true" />
                <span class="doc__label">
                  {v.title}
                  <span class="doc__meta">Posted {v.date}</span>
                  <span class="visually-hidden"> (file opens in a new tab)</span>
                </span>
              </a>
            ) : (
              <span class="doc is-missing"><span class="doc__label">{v.title}<span class="doc__meta">Posted {v.date}</span></span></span>
            )}
          </li>
        ))
      }
    </ul>
    <p class="page-note" data-filter-empty hidden>No position matches that search.</p>
  </section>

  <section class="page-section" id="forms" aria-labelledby="forms-h">
    <h2 id="forms-h">Personal Data Sheet (PDS)</h2>
    {
      pdsForms.map((g) => (
        <ul class="doc-list" role="list">
          {g.links.map((l) => (
            <li>
              <a class="doc" href={l.href} target="_blank" rel="noopener noreferrer">
                <span class="doc__icon icon-start" style="--icon-start: var(--icon-download)" aria-hidden="true" />
                <span class="doc__label">{l.label}<span class="visually-hidden"> (file opens in a new tab)</span></span>
              </a>
            </li>
          ))}
        </ul>
      ))
    }
  </section>

  <section class="page-section" id="policies" aria-labelledby="policies-h">
    <h2 id="policies-h">Employee's corner: PRIME-HRM policy guidelines</h2>
    <div class="policy-grid">
      {
        hrGroups.map((g) => (
          <div class="card">
            <h3>{g.title}</h3>
            <ul class="doc-list" role="list">
              {g.links.map((l) => (
                <li>
                  <a class="doc" href={l.href} target="_blank" rel="noopener noreferrer">
                    <span class="doc__icon icon-start" style="--icon-start: var(--icon-file-text)" aria-hidden="true" />
                    <span class="doc__label">{l.label}<span class="visually-hidden"> (file opens in a new tab)</span></span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </section>

  <section class="page-section eeo" id="eeo" aria-labelledby="eeo-h" data-eeo>
    <h2 id="eeo-h" class="eeo__title">{eeoPolicy.title}</h2>
    <div class="pill-tabs eeo__tabs" role="group" aria-label="Language" data-eeo-tabs hidden>
      <button type="button" aria-pressed="true" data-lang="en">English</button>
      <button type="button" aria-pressed="false" data-lang="tl">Filipino</button>
    </div>
    <div class="eeo__text" lang="en" data-eeo-panel="en">
      {eeoPolicy.en.map((p) => <p>{p}</p>)}
    </div>
    <div class="eeo__text" lang="tl" data-eeo-panel="tl">
      {eeoPolicy.tl.map((p) => <p>{p}</p>)}
    </div>
  </section>
</PageShell>

<script>
  import '../../scripts/listFilter';

  const root = document.querySelector<HTMLElement>('[data-eeo]');
  const tabs = root?.querySelector<HTMLElement>('[data-eeo-tabs]');
  if (root && tabs) {
    // Both languages are in the page; with script, one shows at a time.
    tabs.hidden = false;
    const panels = [...root.querySelectorAll<HTMLElement>('[data-eeo-panel]')];
    const buttons = [...tabs.querySelectorAll<HTMLButtonElement>('button')];
    const show = (lang: string) => {
      panels.forEach((p) => (p.hidden = p.dataset.eeoPanel !== lang));
      buttons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.lang === lang)));
    };
    buttons.forEach((b) => b.addEventListener('click', () => show(b.dataset.lang!)));
    show('en');
  }
</script>
