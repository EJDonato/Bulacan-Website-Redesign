---
/**
 * Hero (design-system §9.5, §9.5.1). Holds the page's only h1.
 *
 * Heading choice: the h1 is a stable, visually hidden "Provincial Government of Bulacan". The visible headline of
 * each slide is a styled <p>, not a heading: a rotating h1 would change the page title for assistive technology,
 * and 13 extra h2s would bury the real section headings in the heading list. Each slide is a labelled group
 * ("3 of 13") and the active title is announced politely through the status region.
 */
import { Image } from 'astro:assets';
import '../styles/buttons.css';
import '../styles/hero.css';
import { slides } from '../data/hero';
import { site } from '../data/site';

const total = slides.length;
// Poster is 2000x897; rendered at roughly 600px on desktop and full width on small screens.
const posterW = 1040;
const posterH = Math.round((posterW * 897) / 2000);
---

<section class="hero" aria-labelledby="hero-heading" data-hero>
  <h1 id="hero-heading" class="visually-hidden">{site.name}</h1>

  <div class="container hero__wrap">
    <div class="hero__frame" role="region" aria-roledescription="carousel" aria-label="Featured announcements">
      <div class="hero__track" tabindex="0" role="group" aria-label="Slides" data-hero-track>
        {
          slides.map((slide, i) => (
            <div
              class:list={['hero__slide', `hero__slide--${slide.variant}`, { 'is-active': i === 0 }]}
              role="group"
              aria-roledescription="slide"
              aria-label={`${i + 1} of ${total}`}
              data-title={slide.title}
            >
              {slide.variant === 'image' && slide.image && (
                <>
                  <Image
                    class="hero__bg"
                    src={slide.image}
                    alt=""
                    width={48}
                    height={22}
                    quality={40}
                    loading={i === 0 ? 'eager' : 'lazy'}
                    decoding="async"
                  />
                  <span class="hero__scrim" aria-hidden="true" />
                </>
              )}

              <div class="hero__content">
                <p class="hero__eyebrow" style="--n: 1">{slide.eyebrow}</p>
                <p class="hero__title" style="--n: 2" lang={slide.lang}>{slide.title}</p>
                {slide.text && (
                  <p class="hero__text" style="--n: 3" lang={slide.textLang}>{slide.text}</p>
                )}
                {slide.dateLabel && <p class="hero__date" style="--n: 4">{slide.dateLabel}</p>}
              </div>

              {slide.variant === 'image' && slide.image && (
                <div class="hero__poster">
                  <Image
                    src={slide.image}
                    alt={slide.imageAlt ?? ''}
                    width={posterW}
                    height={posterH}
                    widths={[480, 720, posterW]}
                    sizes="(min-width: 1025px) 640px, (min-width: 641px) 90vw, 100vw"
                    quality={70}
                    loading={i === 0 ? 'eager' : 'lazy'}
                    fetchpriority={i === 0 ? 'high' : 'auto'}
                    decoding={i === 0 ? 'sync' : 'async'}
                  />
                </div>
              )}
            </div>
          ))
        }
      </div>

      <!-- Controls need script; without it the track is still a scrollable row. -->
      <div class="hero__bar" data-hero-bar>
        <p class="hero__count" aria-hidden="true"><b data-hero-current>1</b> / {total}</p>

        <div class="hero__progress">
          <div class="hero__segs" aria-hidden="true">
            {slides.map(() => <span class="hero__seg" />)}
          </div>
          <input
            class="hero__scrub"
            type="range"
            min="1"
            max={total}
            step="1"
            value="1"
            aria-label="Go to slide"
            data-hero-scrub
          />
        </div>

        <div class="hero__btns">
          <button
            type="button"
            class="hero__btn icon"
            style="--icon: var(--icon-play)"
            aria-label="Start automatic slide change"
            data-hero-play
            data-playing="false"></button>
          <button
            type="button"
            class="hero__btn icon"
            style="--icon: var(--icon-chevron-left)"
            aria-label="Previous slide"
            data-hero-prev
            disabled></button>
          <button
            type="button"
            class="hero__btn icon"
            style="--icon: var(--icon-chevron-right)"
            aria-label="Next slide"
            data-hero-next></button>
        </div>
      </div>

      <p class="visually-hidden" role="status" aria-live="polite" data-hero-status></p>
    </div>
  </div>
</section>

<script>
  import '../scripts/hero';
</script>
