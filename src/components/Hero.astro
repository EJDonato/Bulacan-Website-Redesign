---
/**
 * Hero (design-system §9.5). Holds the page's only h1.
 *
 * Each slide is its full poster, unaltered. The h1 is a stable, visually hidden "Provincial Government of Bulacan":
 * a rotating h1 would change the page title for assistive technology. Each slide is a labelled group ("3 of 13"),
 * the poster's alt text carries everything it says, and the active title is announced politely.
 */
import { Image } from 'astro:assets';
import '../styles/buttons.css';
import '../styles/hero.css';
import { slides, slideAlt } from '../data/hero';
import { site } from '../data/site';

const total = slides.length;
// Posters are 2000x897 and now span the full viewport width.
const posterW = 2000;
const posterH = Math.round((posterW * 897) / 2000);
---

<section class="hero" aria-labelledby="hero-heading" data-hero>
  <h1 id="hero-heading" class="visually-hidden">{site.name}</h1>

  <div class="hero__wrap">
    <div class="hero__frame" role="region" aria-roledescription="carousel" aria-label="Featured announcements">
      <div class="hero__track" tabindex="0" role="group" aria-label="Slides" data-hero-track>
        {
          slides.map((slide, i) => (
            <div
              class:list={['hero__slide', { 'is-active': i === 0 }]}
              role="group"
              aria-roledescription="slide"
              aria-label={`${i + 1} of ${total}`}
              data-title={slide.title}
            >
              <Image
                src={slide.image}
                alt={slideAlt(slide)}
                width={posterW}
                height={posterH}
                widths={[480, 720, 1080, 1440, posterW]}
                sizes="100vw"
                quality={75}
                loading={i === 0 ? 'eager' : 'lazy'}
                fetchpriority={i === 0 ? 'high' : 'auto'}
                decoding={i === 0 ? 'sync' : 'async'}
              />
            </div>
          ))
        }
      </div>

      <!-- Previous and next sit on the left and right edges of the poster (tablet and up; phones swipe). -->
      <button
        type="button"
        class="hero__btn hero__nav hero__nav--prev icon"
        style="--icon: var(--icon-chevron-left)"
        aria-label="Previous slide"
        data-hero-prev
        disabled></button>
      <button
        type="button"
        class="hero__btn hero__nav hero__nav--next icon"
        style="--icon: var(--icon-chevron-right)"
        aria-label="Next slide"
        data-hero-next></button>

      <!-- Controls need script; without it the track is still a scrollable row. -->
      <div class="hero__bar" data-hero-bar>
        <div class="hero__progress">
          <div class="hero__segs" aria-hidden="true">
            {slides.map(() => <span class="hero__seg" />)}
          </div>
          <input
            class="hero__scrub"
            type="range"
            min="1"
            max={total}
            step="1"
            value="1"
            aria-label="Go to slide"
            data-hero-scrub
          />
        </div>
      </div>

      <p class="visually-hidden" role="status" aria-live="polite" data-hero-status></p>
    </div>
  </div>
</section>

<script>
  import '../scripts/hero';
</script>
