---
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/utilities.css';
import '../styles/motion.css';
import '../styles/icon-tokens.css';
import '../styles/icons.css';
import '../styles/sections.css';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
}
const {
  title = 'Provincial Government of Bulacan',
  description = 'A concept redesign of the Provincial Government of Bulacan homepage. Not the official website.',
} = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const fullTitle = `Concept · ${title}`;
// Absolute URLs need the deployed origin (SITE_URL at build time); without it, share cards fall back to site-relative paths.
const abs = (path: string) => (Astro.site ? new URL(`${base}${path}`, Astro.site).href : `${base}${path}`);
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
const ogImage = abs('/og-image.png');
const ogAlt = 'Provincial Government of Bulacan, a concept redesign and not the official website';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="description" content={description} />
    <title>{fullTitle}</title>
    {canonical && <link rel="canonical" href={canonical} />}

    <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
    <link rel="icon" href={`${base}/favicon-32.png`} type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href={`${base}/apple-touch-icon.png`} />
    <link rel="manifest" href={`${base}/site.webmanifest`} />
    <meta name="theme-color" content="#000642" />
    <meta name="author" content="Elton James Donato" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Provincial Government of Bulacan (concept redesign)" />
    <meta property="og:locale" content="en_PH" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogAlt} />
    <!-- Lets CSS tell "script is running" from "no script", so the no-JS layout needs no separate branch. -->
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to main content</a>
    <slot name="header" />
    <main id="main"><slot /></main>
    <Footer />
    <script>
      import '../scripts/reveal';
    </script>
  </body>
</html>
