---
import InnerPage from '../components/InnerPage.astro';
import { dedicatedPages } from '../components/dedicated';
import { pages, slugOf } from '../data/pages';

export function getStaticPaths() {
  return pages.map((page) => ({ params: { slug: slugOf(page.path) }, props: { page } }));
}

const { page } = Astro.props;
const Dedicated = dedicatedPages[page.path];
---

{Dedicated ? <Dedicated page={page} /> : <InnerPage page={page} />}
