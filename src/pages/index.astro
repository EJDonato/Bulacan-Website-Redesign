---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
---
<BaseLayout>
  <Header slot="header" />
  <section class="container scaffold">
    <p class="eyebrow">Concept redesign</p>
    <h1>Provincial Government of Bulacan</h1>
    <p class="scaffold__note">Header and navigation are in. Page sections come next.</p>
  </section>
</BaseLayout>

<style>
  /* Tall enough to scroll, so the sticky header can be tested until real sections replace this. */
  .scaffold { padding-block: var(--space-8); min-block-size: 200vh; }
  .scaffold__note { margin-top: var(--space-3); color: var(--fg-muted); }
</style>
